# ==============================================================================
# Universal AI Video Production Studio - Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env BEFORE RUNNING. NEVER COMMIT REAL SECRETS TO GIT.

# Environment Mode: 'development', 'staging', 'production'
STUDIO_ENV=development

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Filesystem & Persistence Paths
DATABASE_PATH=projects/studio_asset_registry.db
STORAGE_ROOT=assets
TEMP_DIR=temp
LOGS_DIR=logs
BACKUPS_DIR=backups

# Security & CORS (Comma-separated allowed origins)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_CAPACITY=120
RATE_LIMIT_REFILL_PER_SEC=20.0

# Hardware Acceleration ('auto', 'videotoolbox', 'nvenc', 'cpu')
HARDWARE_ACCELERATION=auto
MAX_CONCURRENT_WORKERS=4

# Generative AI Cloud Provider Keys (Optional: leaves system in deterministic fixture mode if unset)
# RUNWAY_API_KEY=your_runway_api_key_here
# TWELVELABS_API_KEY=your_twelvelabs_api_key_here
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

