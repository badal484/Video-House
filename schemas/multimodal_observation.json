{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MultimodalObservationSchema",
  "type": "object",
  "required": [
    "observation_id",
    "asset_id",
    "domain",
    "category",
    "timecode_range",
    "observation",
    "confidence",
    "producer"
  ],
  "properties": {
    "observation_id": {
      "type": "string",
      "format": "uuid"
    },
    "asset_id": {
      "type": "string",
      "format": "uuid"
    },
    "domain": {
      "type": "string",
      "enum": ["visual", "audio", "motion", "temporal", "narrative"]
    },
    "category": {
      "type": "string",
      "enum": [
        "cut_boundary",
        "transition",
        "speech_transcript",
        "speaker_turn",
        "music_tempo",
        "sound_event",
        "camera_motion",
        "object_tracking",
        "scene_semantics",
        "typography_ocr",
        "vfx_detection"
      ]
    },
    "timecode_range": {
      "type": "object",
      "required": ["start_frame", "end_frame", "fps"],
      "properties": {
        "start_time": { "type": "string" },
        "end_time": { "type": "string" },
        "start_seconds": { "type": "number" },
        "end_seconds": { "type": "number" },
        "start_frame": { "type": "integer" },
        "end_frame": { "type": "integer" },
        "fps": { "type": "number" }
      }
    },
    "observation": {
      "type": "object",
      "description": "Structured domain-specific extracted payload."
    },
    "evidence": {
      "type": "object",
      "description": "Empirical mathematical or feature support for the observation."
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "producer": {
      "type": "object",
      "required": ["pipeline", "tool_or_model", "version"],
      "properties": {
        "pipeline": { "type": "string" },
        "tool_or_model": { "type": "string" },
        "version": { "type": "string" }
      }
    }
  }
}
