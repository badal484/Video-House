{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CentralAssetManifestSchema",
  "type": "object",
  "required": [
    "manifest_version",
    "project_id",
    "assets"
  ],
  "properties": {
    "manifest_version": {
      "type": "string"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "name",
          "asset_type",
          "mime_type",
          "uri",
          "checksum_sha256",
          "byte_size",
          "created_at"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "asset_type": {
            "type": "string",
            "enum": [
              "video_raw",
              "video_proxy",
              "video_generated",
              "audio_raw",
              "audio_isolated_stem",
              "audio_mix",
              "image_plate",
              "image_concept",
              "mask_matte",
              "depth_map",
              "scene_usd",
              "graphic_script",
              "subtitles"
            ]
          },
          "mime_type": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "proxy_uri": {
            "type": ["string", "null"]
          },
          "checksum_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "byte_size": {
            "type": "integer"
          },
          "timecode": {
            "type": "object",
            "properties": {
              "start_timecode": { "type": "string" },
              "duration_frames": { "type": "integer" },
              "fps": { "type": "number" },
              "sample_rate": { "type": "integer" }
            }
          },
          "lineage": {
            "type": "object",
            "properties": {
              "parent_asset_ids": {
                "type": "array",
                "items": { "type": "string" }
              },
              "generating_department": { "type": "string" },
              "generating_tool": { "type": "string" }
            }
          },
          "metadata": {
            "type": "object"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
